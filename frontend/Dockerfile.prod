# Production build — the dev Dockerfile runs `npm run dev` (Vite's dev
# server), which is not meant to serve real traffic: no minification, no
# code-splitting optimization, and it carries its own HMR WebSocket. This
# builds static assets and serves them with nginx instead.

FROM node:24-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
# Optional corporate CA remains a build secret and is never copied into the image.
RUN --mount=type=secret,id=build_ca \
    if [ -f /run/secrets/build_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/build_ca; fi; \
    npm ci --no-audit --no-fund --fetch-retries=1 --fetch-timeout=30000
COPY frontend/ .
# VITE_* vars are baked into the JS bundle at build time, not read at
# container-start time — must be passed as build args, not just env vars.
ARG VITE_API_URL
ARG VITE_WS_URL
ARG VITE_MEDIAMTX_WEBRTC_URL
ENV VITE_API_URL=$VITE_API_URL \
    VITE_WS_URL=$VITE_WS_URL \
    VITE_MEDIAMTX_WEBRTC_URL=$VITE_MEDIAMTX_WEBRTC_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY infra/nginx/frontend.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
