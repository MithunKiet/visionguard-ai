# Copy to .env on the production server and fill in REAL values — every
# placeholder below is checked by backend/src/core/settings.py's production
# guard, which refuses to start if any of them are still the dev default.
# Never commit the filled-in .env file.

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=visionguard
POSTGRES_USER=vguser
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+asyncpg://vguser:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@postgres:5432/visionguard

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@redis:6379/0

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=vguser
RABBITMQ_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
RABBITMQ_VHOST=visionguard
RABBITMQ_URL=amqp://vguser:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@rabbitmq:5672/visionguard

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=REPLACE_WITH_A_UNIQUE_ACCESS_KEY
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
MINIO_ACCESS_KEY=REPLACE_WITH_A_UNIQUE_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
# What gets baked into presigned snapshot/report URLs the browser follows —
# must be a real, publicly reachable host:port for your MinIO (or S3-compatible)
# instance, not the internal Docker hostname.
MINIO_PUBLIC_ENDPOINT=your-minio-domain.example.com

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_64_OUTPUT

# ─── AI Worker shared secret ───────────────────────────────────────────────────
WORKER_API_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# ─── MediaMTX publish credentials ──────────────────────────────────────────────
# Required if you use mediamtx for anything in production (a real-camera relay,
# or the demo feeder) — unauthenticated publish would let anyone who can reach
# port 8554 inject/replace a camera's video feed.
MEDIAMTX_PUBLISH_USER=REPLACE_WITH_A_UNIQUE_USERNAME
MEDIAMTX_PUBLISH_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# ─── Backend ──────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
# The real domain(s) your frontend is served from — CORS rejects everything else.
ALLOWED_ORIGINS=https://your-domain.example.com

# ─── Frontend build args (see docker-compose.prod.yml) ────────────────────────
# Must be absolute — the browser's WebSocket API doesn't accept relative URLs.
VITE_WS_URL=wss://your-domain.example.com
VITE_MEDIAMTX_WEBRTC_URL=https://your-mediamtx-domain.example.com

# ─── Observability ────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# ─── Everything else (SMTP, Slack, Roboflow, seed script overrides, …) ────────
# — same as .env.example, copy those over and fill in real values as needed.
