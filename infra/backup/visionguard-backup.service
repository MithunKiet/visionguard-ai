# Example only; install after configuring the operator environment and approved cadence.
[Unit]
Description=VisionGuard verified PostgreSQL and object backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=visionguard-backup
Group=visionguard-backup
WorkingDirectory=/var/lib/visionguard-backup
EnvironmentFile=/etc/visionguard/backup.env
ExecStart=/opt/visionguard/backend/.venv/bin/python /opt/visionguard/infra/backup/recovery.py create
TimeoutStartSec=2h
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/visionguard-backup
